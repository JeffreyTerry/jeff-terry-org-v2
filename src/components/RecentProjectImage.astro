---
import { Image } from "astro:assets";

interface Props {
  projectUrl: string;
  projectName: string;
  image: ImageMetadata;
}

const { projectUrl, projectName, image } = Astro.props;
---

<figure class="img-figure">
  <Image
    src={image}
    alt={projectName}
    widths={[480, 800, 1200, 1600]}
    sizes="(min-width: 3800px) 15vw, (min-width: 2800px) 20vw, (min-width: 1200px) 26vw, (min-width: 768px) 39vw, 80vw"
    class="project-image"
  />
  <figcaption class="img-figcaption">
    <h3 class="caption-project-name">{projectName}</h3>
    <a class="caption-view-project-button" href={projectUrl}>Try It Out!</a>
  </figcaption>
</figure>

<style>
  .img-figure {
    position: relative;
  }

  .project-image {
    display: block;
    width: 100%;
  }

  .img-figcaption {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
    color: var(--light-bg-color);
    z-index: 1;
    text-align: center;
    transition: all 0.3s ease-out;
    padding-top: calc(50% - 6.4rem);
  }
  .img-figcaption > * {
    opacity: 0;
  }
  .img-figcaption:hover {
    padding-top: calc(50% - 6.1rem);
    background-color: rgba(45, 114, 143, 0.9);
  }
  .img-figcaption:hover > * {
    opacity: 1;
  }

  /* Modify the margin-bottom for the project name to make it look like the
  button comes up from the bottom of the caption */
  .caption-project-name {
    font-size: 2.4rem;
    color: var(--light-bg-color);
    cursor: default;
    transition: margin-bottom 0.3s ease-out;
    margin-bottom: 1.3rem;
  }
  .img-figcaption:hover .caption-project-name {
    margin-bottom: 0.7rem;
  }

  .caption-view-project-button {
    color: var(--light-bg-color);
    border: 2px solid var(--light-bg-color);
    border-radius: 2rem;
    font-size: 1.3rem;
    display: inline-block;
    padding: 0.25rem 2.5rem;
    width: fit-content;
    font-family: "Montserrat", sans-serif;
    text-decoration: none;
  }
  .caption-view-project-button:hover {
    text-decoration: inherit;
    color: var(--light-primary-color);
    background-color: var(--light-bg-color);
  }
</style>
