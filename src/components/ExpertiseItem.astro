---
import type { IconDefinition } from "@fortawesome/fontawesome-svg-core";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import StarRating from "./StarRating.astro";

interface Props {
  name: string;
  stars: number;
  icon?: IconDefinition;
  iconColor?: string;
  image?: ImageMetadata;
}

const { name, stars, icon, iconColor, image } = Astro.props;
---

<div class="col-6 col-sm-4 col-md-3 col-xl-2 expertise-item">
  <div class="expertise-item-container">
    {icon && <Icon icon={icon} color={iconColor} class="expertise-item-icon" />}
    {
      image && (
        <Image
          src={image}
          alt={`The '${name}' logo`}
          widths={[100, 200]}
          sizes="(min-width: 2800px) 4vw, (min-width: 1800px) 6vw, (min-width: 992px) 6.38vw, (min-width: 768px) 8.38vw, (min-width: 576px) 11.38vw, 17.38vw"
          class="expertise-item-image"
        />
      )
    }
    <h3 class="expertise-item-name">{name}</h3>
    <StarRating stars={stars} />
  </div>
</div>

<style>
  .expertise-item {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .expertise-item-container {
    width: 100%;
    text-align: center;
  }

  .expertise-item-icon {
    margin-bottom: 0.4rem;
    font-size: 19vw;
  }
  @media (min-width: 576px) {
    .expertise-item-icon {
      font-size: 12.825vw;
    }
  }
  @media (min-width: 768px) {
    .expertise-item-icon {
      font-size: 9.55vw;
    }
  }
  @media (min-width: 992px) {
    .expertise-item-icon {
      font-size: 7.25vw;
    }
  }
  @media (min-width: 1800px) {
    .expertise-item-icon {
      font-size: 6.65vw;
    }
  }
  @media (min-width: 2800px) {
    .expertise-item-icon {
      font-size: 4.6vw;
    }
  }

  .expertise-item-image {
    margin-top: 0.425vw;
    width: 17.38vw;
    display: inline-block;
    margin-bottom: 0.38rem;
    vertical-align: top;
  }
  @media (min-width: 576px) {
    .expertise-item-image {
      width: 11.38vw;
    }
  }
  @media (min-width: 768px) {
    .expertise-item-image {
      width: 8.38vw;
    }
  }
  @media (min-width: 992px) {
    .expertise-item-image {
      width: 6.38vw;
    }
  }
  @media (min-width: 1800px) {
    .expertise-item-image {
      width: 6vw;
    }
  }
  @media (min-width: 2800px) {
    .expertise-item-image {
      width: 4vw;
    }
  }

  .expertise-item-name {
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
  }
  @media (min-width: 576px) {
    .expertise-item-name {
      font-size: 2rem;
    }
  }
  @media (min-width: 1800px) {
    .expertise-item-name {
      font-size: 2.5rem;
    }
  }
  @media (min-width: 2800px) {
    .expertise-item-name {
      font-size: 3rem;
    }
  }
</style>
