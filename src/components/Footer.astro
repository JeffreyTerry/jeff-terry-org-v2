---
import { faHeart } from "@fortawesome/free-solid-svg-icons";
import GetInTouchButton from "./GetInTouchButton.astro";
import Icon from "./Icon.astro";
---

<footer class="row footer-row">
  <div class="col-12 col-3k-8 offset-3k-2 col-4k-6 offset-4k-3">
    <div class="get-in-touch-row text-center">
      <GetInTouchButton />
    </div>
    <div class="row">
      <div class="col-12">
        Made with <Icon icon={faHeart} /> in Oklahoma and North Carolina.
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-row {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
    text-align: center;
    font-size: 1.1rem;
  }
  @media (min-width: 576px) {
    .footer-row {
      font-size: 1.75rem;
    }
  }

  .get-in-touch-row {
    margin-bottom: 2.75rem;
  }
  @media (min-width: 768px) {
    .get-in-touch-row {
      margin-top: 0.5rem;
      margin-bottom: 3rem;
    }
  }
</style>
